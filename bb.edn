{:paths ["src" "script" "test" "test-resources"]
 :deps  {metosin/malli         {:mvn/version "0.20.1"}
         instaparse/instaparse {:mvn/version "1.5.0"}}

 ;; bbin install io.github.TrustBlocks/concerto-clj --as concerto-clj
 ;; (or `bbin install . --as concerto-clj` from a checkout)
 :bbin/bin {concerto-clj {:main-opts ["-m" "com.trustblocks.concerto.cli"]}}

 :tasks
 {cli {:doc "The command line: bb cli validate --input sample.json --model model.json"
       :requires ([com.trustblocks.concerto.cli :as cli])
       :task (apply cli/-main *command-line-args*)}}}
